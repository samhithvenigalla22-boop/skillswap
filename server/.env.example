# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas URI here (or leave blank for in-memory MongoDB in development)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillswap?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# JWT Authentication Secret
JWT_SECRET=skillswap_jwt_super_secret_key_change_in_production
JWT_EXPIRE=30d

# Client URL (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# Admin Initial Setup (Used by seedAdmin.js)
ADMIN_NAME=SkillSwap Admin
ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=Admin@123456
